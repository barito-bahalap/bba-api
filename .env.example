# Vercel project: bba-api   (Settings -> Environment Variables)
# Server-side only. No secret may carry a VITE_ prefix (the API refuses to start if one exists).

# ---- REQUIRED ------------------------------------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # service-role / secret key. Never VITE_*, never committed.

# Random secret used to HASH visitor IPs/emails before they are stored for rate limiting
# (so the database never holds raw IPs). Any random string >= 16 chars; generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
RATE_LIMIT_SALT=

# Which websites may call this API. The value becomes inquiries.source_site.
# Production: only the real site. Put localhost in the Preview environment only.
ALLOWED_ORIGINS={"https://baritobahalap.com":"corporate"}

# ---- OPTIONAL: leave blank until you want them. Nothing needs rewiring later. ----------------
# Captcha. Blank = off. Set the secret (and VITE_TURNSTILE_SITE_KEY on the site) to turn it on.
TURNSTILE_SECRET_KEY=

# Email notifications + acknowledgment to the sender. Blank = off (inquiries are only stored).
# All five must be set together.
RESEND_API_KEY=
MAIL_FROM=
INBOX_TECH=
INBOX_MEDIA=
INBOX_INQUIRY=
DASHBOARD_URL=
