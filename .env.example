# Vercel project: bba-api   (Settings -> Environment Variables; Production + Preview)
# Every value here is SERVER-SIDE ONLY. Nothing in this project is ever bundled to a browser,
# and no secret may carry a VITE_ prefix (the API refuses to start if one exists).

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # service-role / secret key. Never VITE_*, never committed.

TURNSTILE_SECRET_KEY=                 # Cloudflare Turnstile secret. Dev: 1x0000000000000000000000000000000AA (always passes)

RESEND_API_KEY=
MAIL_FROM="Barito Bahalap <no-reply@notify.baritobahalap.com>"   # must be on the domain you verified in Resend

INBOX_TECH=tech@baritobahalap.com
INBOX_MEDIA=media@baritobahalap.com
INBOX_INQUIRY=inquiry@baritobahalap.com

RATE_LIMIT_SALT=                      # >= 16 random chars:  openssl rand -hex 24
ALLOWED_ORIGINS={"https://baritobahalap.com":"corporate","https://tech.baritobahalap.com":"tech","https://media.baritobahalap.com":"media"}

# optional
DASHBOARD_URL=
